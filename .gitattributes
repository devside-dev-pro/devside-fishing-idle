# Normalisation des fins de ligne
* text=auto

# Fichiers YAML Unity : diff texte + merge dédié (UnityYAMLMerge)
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.meta text eol=lf
*.asmdef text eol=lf
*.cs text eol=lf

# Binaires → Git LFS (installer git-lfs avant d'ajouter le premier asset binaire)
